    }
  }
  {
    SERVICE <http://example.org/c> {
      ?w0 <http://www.lehigh.edu//univ-bench.owl#name> ?name .
    }
  }
  UNION {
    SERVICE <http://example.org/d> {
      ?w0 <http://www.lehigh.edu//univ-bench.owl#name> ?name .
